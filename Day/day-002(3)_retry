import requests
import json
import functools
import time

def retry(max_retries=3,delay=1):
    """重试装饰器"""
    def decorator(func):
        @functools.wraps(func)
        def wrapper(*args,**kwargs):
            for attempts in range (1,max_retries+1):
                try:
                    return func(*args,**kwargs)
                except requests.exceptions.Timeout as e:
                    print(f"超时，{func.__name__}第{attempts}次重试\n{e}")
                except requests.exceptions.ConnectionError as e:
                    print(f"连接错误，{func.__name__}第{attempts}次重试\n{e}")
                except requests.exceptions.HTTPError as e:
                    print(f"HTTP错误，{func.__name__}第{attempts}次重试\n{e}")
                    if 400 <= e.response.status_code < 500:
                        raise                
                if attempts == max_retries:
                    raise e  
#               raise RuntimeError ("重试{0}失败:{1}".format(max_retries,func.__name__))
                wait = delay * 2 ** (attempts - 1)
                print(f"等待{wait}秒")
                time.sleep(wait)                             
        return wrapper
    return decorator

@retry(max_retries=3,delay=1)
def fetch_data(url,userId):
    """拿数据"""
    resp =requests.get(
        url,
        params = {"userId": userId},
        timeout = 10
    )
    resp.raise_for_status()
    return resp.json()

