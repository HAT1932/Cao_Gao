import pandas as pd

df = pd.read_csv("dirty_orders.csv")

print("==== 清洗前体检 ====")

print(f"{df.shape[0]} 行，{df.shape[1]} 列")
#print(df.describe())
print (f"\n数据类型:\n{df.dtypes}")
print(f"\n缺失值：\n{df.isna().sum()}")

print("==== 处理记录 ====")
dup_mask = df.duplicated(subset = ["order_id"],keep = "first")
drop = df.loc[dup_mask]
drop_len = len(drop)
drop_ids = drop["order_id"].tolist()
#df_clean = df[~dup_mask]
print(f"[4]order_id: 重复数：{df.duplicated(subset=['order_id']).sum()}/{drop_len}条，去除重复为{drop_ids}")
df =df.drop_duplicates(subset=["order_id"],keep = "first")

before = df["city"].copy()
df["city"] = df["city"].str.strip()
diff = before.str.len() - df["city"].str.len() 
df["city"] = df["city"].replace("",pd.NA)
df["city"] = df["city"].fillna("未知") 
print (f"[1]city: 去除{int(diff.sum())}格子, {int((diff>0).sum())}个数据")
df["city"] = df["city"].str.replace("hangzhou","杭州",regex=False)

#amount---.str.replace---pd.to_numeric
before = df["amount"].astype(str).copy()
df["amount"] = (
    df["amount"]
    .astype(str)
    .str.replace("￥", "", regex=False)
    .str.replace(",", "", regex=False)
    .replace({"": None, "nan": None})
)
diff = before.str.len() - df["amount"].str.len()
df["amount"] = pd.to_numeric(df["amount"],errors = "coerce")
print(f"[2]amount: 去除{int(diff.sum())}格子, {int((diff>0).sum())}个数据")


#  异常值
#df = df[(df["amount"]<10000) | (df["amount"].isna())]
df["status"] = "正常"
n_sent = int((df["amount"] == 999999.0).sum())
n_blank = int (df["amount"].isna().sum())
df.loc[df["amount"] == 999999.0,"status"] = "金额异常"
df.loc[df["amount"].isna(),"status"] = "空数据"
df["amount"] = df["amount"].replace(999999.0,pd.NA)
print(f"去异常值{n_sent}格，哨兵替换为缺失。空格{n_blank}格")

#   退款
df.loc[df["amount"]<0,"status"] = "退货"    
positive_median = df.loc[df["amount"]>0,"amount"].median()
print(f"[3]amount: 哨兵:{n_sent}格 + 缺失{df['amount'].isna().sum()}格子,替换为中位数{positive_median}")
df["amount"] = df["amount"].fillna(positive_median)



df["quantity"] = pd.to_numeric(df["quantity"], errors="coerce")
df["quantity"] = df["quantity"].astype("Int64")

df["order_date"] = pd.to_datetime(df["order_date"], format = "mixed" , errors = "coerce" ) 

#print(df.dtypes)
#print(df)



df.to_csv("clean_orders_v1.csv",index = False, encoding = "utf-8-sig" , float_format = "%.2f",date_format="%Y-%m-%d")


